APP_NAME="Company 2"
APP_ENV=local
APP_KEY=base64:GENERATE_THIS_WITH_php_artisan_key_generate
APP_DEBUG=true
APP_URL=http://localhost/backend/public

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=company2_db
DB_USERNAME=root
DB_PASSWORD=           # leave blank for default XAMPP

APP_URL=http://localhost/backend/public

# For XAMPP with password:
# DB_PASSWORD=your_mysql_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost,127.0.0.1
SESSION_DOMAIN=localhost

# Google OAuth (replace with your credentials)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# CORS - allow Vue dev server
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Admin default credentials (used by seeder only)
ADMIN_EMAIL=admin@company2.sa
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME="Super Admin"
